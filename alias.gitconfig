[alias]
	hi = "!f() { echo 'Hello, ' $1; }; f"
	
	alias-update = cfg-update

	st = status -s -b
	co = checkout

	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
	graph = log --pretty --oneline --graph --decorate
	
	sync = "!f() { git checkout \"$1\" && git pull && git checkout -; }; f"
	gone = "!f() { \
			git fetch -p || return 1; \
			local gone=$(git branch -vv | awk '$1 != \"+\" && $1 != \"*\" && /: gone]/ {print $1}'); \
			if [ -n \"$gone\" ]; then echo \"$gone\" | xargs git branch -D; fi; \
			local wt=$(git branch -vv | awk '$1 == \"+\" && /: gone]/ {print $2}'); \
			if [ -n \"$wt\" ]; then \
					echo; \
					echo 'warning: the following branches are gone on the remote but are checked out in a worktree, so they were NOT deleted:'; \
					for b in $wt; do \
							local p=$(git worktree list --porcelain | awk -v ref=\"refs/heads/$b\" '/^worktree / {w = substr($0, 10)} $0 == \"branch \" ref {print w}'); \
							echo \"  - $b\"; \
							echo \"    worktree: $p\"; \
							echo \"    remove with: git worktree remove \\\"$p\\\"\"; \
					done; \
					echo 'warning: remove these worktrees manually, then run \"git gone\" again to delete the branches.'; \
			fi; \
	}; f"
	
	diff = difftool -t 
	
	search = !git rev-list --all | xargs git grep -F
	compare = rev-list --count --left-right
	
	synced = !ls -ll .git/FETCH_HEAD
	untracked = !git ls-files --others --exclude-standard

	# commit
	cm = commit -m
	cam = commit -am

	# branch
	br = "!f() { \
			if [ \"$1\" = \"+\" ]; then \
					git branch --sort=-committerdate | cat; \
			elif [ \"$1\" = \"-\" ]; then \
					git branch --sort=committerdate | cat; \
			else \
					git branch --sort=-committerdate; \
			fi; \
	}; f"

	br-new = co -b
	brn = br-new
	nbr = br-new
	
	br-current = rev-parse --abbrev-ref HEAD
	brc = br-current
	cbr = br-current
	

	br-contains-all = "!f() { \
			ref=\"${1:-$(git rev-parse --abbrev-ref HEAD)}\"; \
			git fetch --all --quiet; \
			git branch -a --contains \"$ref\"; \
	}; f"
	brca = br-contains-all

	br-contains = "!f() { \
			ref=\"${1:-$(git rev-parse --abbrev-ref HEAD)}\"; \
			git branch --contains \"$ref\"; \
	}; f"
	brc = br-contains

	br-missing-commits = "!f() { \
			interactive=0; p1=\"\"; p2=\"\"; \
			for a in \"$@\"; do \
					if [ \"$a\" = \"-i\" ]; then interactive=1; \
					elif [ -z \"$p1\" ]; then p1=\"$a\"; \
					else p2=\"$a\"; fi; \
			done; \
			if [ -n \"$p2\" ]; then src=\"$p1\"; target=\"$p2\"; \
			else src=$(git rev-parse --abbrev-ref HEAD); target=\"${p1:-$(git rev-parse --abbrev-ref HEAD)}\"; fi; \
			echo \"Commits in '$src' missing from '$target':\"; \
			if [ \"$interactive\" = \"1\" ]; then \
					git log \"$target\"..\"$src\"; \
			else \
					git log \"$target\"..\"$src\" --oneline | cat; \
			fi; \
	}; f"
	brmc = br-missing-commits
	
	br-is-merged = "!f() { \
			interactive=0; p1=\"\"; p2=\"\"; \
			for a in \"$@\"; do \
					if [ \"$a\" = \"-i\" ]; then interactive=1; \
					elif [ -z \"$p1\" ]; then p1=\"$a\"; \
					else p2=\"$a\"; fi; \
			done; \
			if [ -n \"$p2\" ]; then src=\"$p1\"; target=\"$p2\"; \
			else src=$(git rev-parse --abbrev-ref HEAD); target=\"${p1:-$(git rev-parse --abbrev-ref HEAD)}\"; fi; \
			if git merge-base --is-ancestor \"$src\" \"$target\"; then \
					echo \"YES: '$src' is fully merged into '$target'\"; \
			else \
					echo \"NO: '$target' is missing the following commits from '$src':\"; \
					if [ \"$interactive\" = \"1\" ]; then \
							git log \"$target\"..\"$src\"; \
					else \
							git log \"$target\"..\"$src\" --oneline | cat; \
					fi; \
			fi; \
	}; f"
	brim = br-is-merged
	ibrm = br-is-merged
	
	# tag
	tag-push-annotated = push origin --follow-tags
	tag-push = push origin --tags
	tag-pull = fetch --tags
	tag-last = describe --tags --abbrev=0
	tag-delete = "!f() { \
			if [ $# -eq 0 ]; then echo 'usage: git tag-delete <tag> [<tag>...]'; return 1; fi; \
			for t in \"$@\"; do \
					git tag -d \"$t\"; \
					git push origin --delete \"refs/tags/$t\"; \
			done; \
	}; f"
	tag-log = "!f() { git tag -l --sort=-creatordate --format='%(creatordate:short)  %(refname:short)  %(subject)' \"$@\"; }; f"
	
	# clean
	cln = clean -n
	clnf = clean -f
	clnd = clean -d
	clnx = clean -x

	# from https://github.com/Lior-Katz
	last = log -1 HEAD --stat
	unstage = restore --staged
	cfglist = config --global -l
	cfgalias = ! git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\ =\\ /
	diff-vim = difftool -t vimdiff -y
	diff-words = diff --color-words='[^[:space:]]|([[:alnum:]]|UTF_8_GUARD)+'
	
[color.decorate]
	branch = 41
	HEAD = "#00ffff" bold 

[grep]
	lineNumber = true
	patternType = perl

[help]
	autocorrect = 20

[rerere]
	enabled = true

[push]
	autoSetupRemote = true
