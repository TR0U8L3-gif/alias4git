[alias]
	hi = "!f() { echo 'Hello, ' $1; }; f"

	st = status -s -b
	co = checkout
	nbr = co -b
	cm = commit -m
	cam = commit -am
	br = !git branch --sort=-committerdate | cat
	sync = "!f() { git checkout \"$1\" && git pull && git checkout -; }; f"
	gone = !git fetch --all --prune && git branch --format '%(refname:short) %(upstream:track)' | awk '/\\[gone\\]/{print \$1}' | xargs -r git branch -D
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
	
	cln = clean -n
	clnf = clean -f
	clnd = clean -d
	clnx = clean -x
	
	diff = difftool -t 
	graph = log --pretty --oneline --graph --decorate
	search = !git rev-list --all | xargs git grep -F
	compare = rev-list --count --left-right
	synced = !ls -ll .git/FETCH_HEAD
	untracked = !git ls-files --others --exclude-standard

	# from https://github.com/Lior-Katz
	last = log -1 HEAD --stat
	unstage = restore --staged
	cfglist = config --global -l
	cfgalias = ! git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\ =\\ /
	diff-vim = difftool -t vimdiff -y
	diff-words = diff --color-words='[^[:space:]]|([[:alnum:]]|UTF_8_GUARD)+'
	
[color.decorate]
	branch = 41
	HEAD = "#00ffff" bold 

[grep]
	lineNumber = true
	patternType = perl

[help]
	autocorrect = 20

[rerere]
	enabled = true

[push]
	autoSetupRemote = true

[pull]
	rebase = true
